TELEGRAM_BOT_TOKEN=
RPC_URL=
CONTRACT_ADDRESS=
OWNER_PRIVATE_KEY=
SESSION_KEY_PRIVATE_KEY=
ROCK_BURGER_ADDRESS=
EVIL_STORE_ADDRESS=
BROADCAST_REVERTS=false

# Powers the real Claude agent used for free-text Telegram messages
# (apps/telegram-bot/src/llm-agent.ts). Set one of the three below.
ANTHROPIC_API_KEY=

# Optional: if set, routes through DeepSeek's Anthropic-compatible endpoint
# (api.deepseek.com/anthropic) instead of Claude — same SDK, unmodified.
DEEPSEEK_API_KEY=

# Optional: if set (and DEEPSEEK_API_KEY is not), routes through AI/ML API
# (api.aimlapi.com), which proxies real Claude models.
AIML_API_KEY=

# Optional: overrides the model id. DeepSeek/AIML default to their cheapest
# tier to save test credits; direct Claude defaults to claude-opus-5.
AGENT_MODEL=
