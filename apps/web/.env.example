# Chain the interface reads and writes. 84532 = Base Sepolia.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# LeashMandate address on the chain above.
# Leave unset until a real deployment exists — the interface renders an
# explicit "not deployed" state rather than implying an address it does not have.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Block the mandate log query starts from. The deployment block, not 0.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Demo merchants shown in the agent's directory. Evil Store must be reachable:
# an agent that cannot attempt the disallowed target cannot demonstrate refusal.
NEXT_PUBLIC_ROCK_BURGER_ADDRESS=
NEXT_PUBLIC_EVIL_STORE_ADDRESS=

# Server-side only. The agent route handler signs authorizePayment with this key.
SESSION_KEY_PRIVATE_KEY=

# Server-side only.
ANTHROPIC_API_KEY=
