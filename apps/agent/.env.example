ANTHROPIC_API_KEY=

# Optional: if set, the agent routes through DeepSeek's Anthropic-compatible
# endpoint (api.deepseek.com/anthropic) instead of Claude — same SDK, same tool
# loop, unmodified. Testing toggle only; unset to go back to ANTHROPIC_API_KEY.
DEEPSEEK_API_KEY=

# Optional: if set (and DEEPSEEK_API_KEY is not), routes through AI/ML API
# (api.aimlapi.com), which proxies real Claude models — testing toggle only.
AIML_API_KEY=

# Optional: overrides the model id. DeepSeek/AIML default to their cheapest tier
# (deepseek-v4-flash / claude-haiku-4-5-20251001) to save test credits; direct
# Claude defaults to claude-opus-5. Only takes effect on whichever provider above
# is actually selected.
AGENT_MODEL=deepseek-v4-flash
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
SESSION_KEY_PRIVATE_KEY=
ROCK_BURGER_ADDRESS=
EVIL_STORE_ADDRESS=

# Required by `npm run agent` (a mandate must already be registered on-chain).
MANDATE_ID=

# Required by `npm run scenario` only (it registers its own mandate).
OWNER_PRIVATE_KEY=
