{"nodes": [{"id": "authorization_settlement_boundary", "label": "Authorization vs Settlement Boundary", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AuthorizationGranted means the request satisfied the on-chain mandate at a particular block. It does not mean money moved. The two are never conflated in code, copy, or interface."}, {"id": "product_definition", "label": "Product Definition", "file_type": "document", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contract_is_only_gate", "label": "Contract is the Only Gate", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforcement never moves off-chain for convenience. Any client-side check that duplicates the contract's logic conceals whether the real gate works. The frontend and agent are clients of the contract, never reimplementers of enforcement."}, {"id": "agent_is_untrusted", "label": "Agent is Untrusted by Design", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The agent is expected to be wrong, manipulated, or compromised. Hardening the agent rather than the boundary would defend at the wrong layer. A successful prompt injection that the contract rejects is the demonstration, not a bug."}, {"id": "claim_only_verified", "label": "Claim Only What Is Verified", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mocked components are named as mocked, unbuilt things stay unclaimed, and the gap between proven and production-ready is stated rather than blurred."}, {"id": "no_client_side_enforcement", "label": "No Client-Side Policy Enforcement", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Policy enforcement happens on-chain only. No client-side allowlist, cap, or expiry check anywhere in the frontend or the agent's tools. Duplicating the gate off-chain would relocate trust to the exact layer the product argues against."}, {"id": "nextjs", "label": "Next.js", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wagmi", "label": "wagmi", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tailwind_css", "label": "Tailwind CSS", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "product_definition", "target": "leash", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_definition", "target": "design_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "web_frontend", "target": "nextjs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "web_frontend", "target": "wagmi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "web_frontend", "target": "tailwind_css", "relation": "references", "